# Copy this file to .env and fill in real values. Never commit .env.

# Flask secret key used for session signing and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Set to true only for local development.
FLASK_DEBUG=false

# Path to the SQLite database file used for forecast run history.
DATABASE_PATH=instance/app.db

# Maximum allowed CSV upload size, in megabytes.
MAX_UPLOAD_MB=25

# Port the Flask dev server binds to.
PORT=5000
